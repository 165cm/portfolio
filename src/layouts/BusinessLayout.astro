---
// 事業者ページ（ぱぱぞんアプリ）共通のレイアウト。
// 趣味の作品一覧（BaseLayout）とは見た目・ナビを分け、決済の審査や購入者が
// 必要な情報（事業者・サービス・価格・連絡先・各種ポリシー）にすぐたどり着けるようにする。
import '../styles/global.css';
import { business } from '../data/business';
interface Props {
  title: string;
  description?: string;
}
const { title, description = `${business.name}（${business.nameEn}）— ${business.description}` } = Astro.props;
const b = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/business`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap"
    />
  </head>
  <body class="biz">
    <header class="site-header">
      <div class="container">
        <a href={`${b}/`} class="brand">{business.name}<span class="brand-en">{business.nameEn}</span></a>
        <nav>
          <a href={`${b}/#services`}>サービス・料金</a>
          <a href={`${b}/#contact`}>お問い合わせ</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="legal-links">
          <a href={`${b}/tokushoho/`}>特定商取引法に基づく表記</a>
          <a href={`${b}/refund/`}>返金・キャンセルポリシー</a>
          <a href={`${b}/terms/`}>利用規約</a>
          <a href={`${b}/privacy/`}>プライバシーポリシー</a>
        </nav>
        <p>お問い合わせ：<a href={`mailto:${business.email}`}>{business.email}</a></p>
        <p>© {business.established} {business.name}（{business.nameEn}）</p>
      </div>
    </footer>
  </body>
</html>
