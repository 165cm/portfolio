---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import ConsultChat from '../components/ConsultChat.astro';
import { featuredApps } from '../data/apps';
import { consult, services, fits, steps } from '../data/consult';
import { owner } from '../data/business';
import { fetchRepoMeta } from '../data/repoUpdates';
import { resolveShots } from '../data/screenshots';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ビルド時にリポジトリの About の Website を取得し、公開ページへのリンクに使う。
// 取得できない場合や、Website がこのポートフォリオ自身を指す場合は links.demo を使う。
const repoMeta = await fetchRepoMeta(featuredApps);
const isSelfUrl = (url: string) => url.includes('165cm.github.io/portfolio');
const publicUrlOf = (slug: string, demo?: string) => {
  const homepage = repoMeta[slug]?.homepage;
  return homepage && !isSelfUrl(homepage) ? homepage : demo;
};

const nameOf = (slug: string) => featuredApps.find((a) => a.slug === slug)?.name;
// 作品の画像（作品リポジトリの docs/portfolio/ にあれば最新のものを使う）
const shots = await resolveShots(featuredApps);

// ヒーローの「ターミナル風」の飾り。中身は実際の作品名とデリ勘のテスト件数
type TermLine = { text: string; prompt?: boolean; cls?: string; note?: string };
const terminalLines: TermLine[] = [
  { text: 'whoami', prompt: true },
  { text: `${owner.name} — 家電修理エンジニア / 個人開発者`, cls: 'o' },
  { text: 'ls', prompt: true },
  ...featuredApps.map((a) => ({ text: `${a.emoji} ${a.name}`, cls: 'o' })),
  { text: 'npm test', prompt: true, note: 'デリ勘' },
  { text: '✓ 112 passed', cls: 'ok' },
  { text: 'npm run e2e', prompt: true },
  { text: '✓ 14 passed', cls: 'ok' },
];

// 数字の実績。専門用語を知らない人にも伝わるよう、それぞれに説明を付ける
const proofs = [
  {
    num: String(featuredApps.length),
    unit: '作品',
    title: '公開中の作品',
    text: 'どれも今すぐ開いて触れます。下書きや練習ではなく、実際に使われているものだけを載せています。',
  },
  {
    num: '2',
    unit: 'サイト',
    title: '専用アドレスで運営',
    text: '「aircon-hokenshitsu.com」のような自分専用のアドレス（独自ドメイン）を取り、公開から運営まで自分で行っています。',
  },
  {
    num: '有料版',
    unit: '',
    title: '販売の実績',
    text: '確定申告ツールは有料版を販売中です。お金を払って使ってもらえる品質まで仕上げています。',
  },
  {
    num: '126',
    unit: '項目',
    title: '自動チェック',
    text: '直すたびに、計算や画面の動きが正しいかを機械が126項目確かめます。「直したら別の所が壊れた」を防ぐ仕組みです。',
  },
];
---
<BaseLayout title={`${owner.name} — 現場と暮らしの小さなアプリを作る個人開発者`}>
  <section class="hero-band" slot="band">
    <div class="container hero">
      <div class="hero-text">
        <p class="eyebrow">個人開発者 / 家電修理エンジニア</p>
        <h1><span class="nw">現場の「ちょっと困った」を、</span><wbr /><span class="nw">スマホで使えるアプリに。</span></h1>
        <p class="lead">
          {owner.name}です。家電修理の現場で働きながら、仕事や暮らしの道具をアプリにしています。
          企画から公開・販売・運営まで、ひとりで回しています。
        </p>
        <p class="lead">小さなツールの開発のご相談を、副業として少しだけ受け付けています。</p>
        <div class="hero-actions">
          <a class="btn primary" href="#consult">開発の相談をする</a>
          <a class="btn btn--on-dark" href="#works">作品を見る</a>
        </div>
      </div>
      <div class="terminal" aria-hidden="true">
        <div class="terminal-bar"><span></span><span></span><span></span><em>~/works</em></div>
        <pre><code>{terminalLines.map((l) => (
          <span class="line">{l.prompt && <span class="p">$ </span>}<span class={l.cls}>{l.text}</span>{l.note && <span class="c">  # {l.note}</span>}</span>
        ))}<span class="line"><span class="p">$ </span><span class="cursor"></span></span></code></pre>
      </div>
    </div>
  </section>

  <section class="section proofs-section">
    <p class="sec-label">numbers</p>
    <h2>数字で見る実績</h2>
    <ul class="proofs">
      {proofs.map((p) => (
        <li>
          <p class="proof-num">{p.num}<small>{p.unit}</small></p>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="works" class="section">
    <p class="sec-label">works</p>
    <h2>最近の作品</h2>
    <p class="section-lead">どれも自分や身近な人の困りごとから生まれ、実際に使われている作品です。</p>
    <div class="works">
      {featuredApps.map((app, i) => (
        <WorkCard app={app} shot={shots[app.slug]} publicUrl={publicUrlOf(app.slug, app.links.demo)} reverse={i % 2 === 1} />
      ))}
    </div>
  </section>

  <section id="services" class="section">
    <p class="sec-label">services</p>
    <h2>お手伝いできること</h2>
    <div class="services">
      {services.map((s) => (
        <div class="service">
          <div class="service-icon" aria-hidden="true">{s.icon}</div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          {nameOf(s.example) && <a href={`${base}/apps/${s.example}`}>例：{nameOf(s.example)} →</a>}
        </div>
      ))}
    </div>
    <div class="fits">
      <div class="fit fit--good">
        <h3>こんなご相談に向いています</h3>
        <ul>{fits.good.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="fit fit--bad">
        <h3>お受けしにくいもの</h3>
        <ul>{fits.bad.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
  </section>

  <section id="flow" class="section">
    <p class="sec-label">flow</p>
    <h2>進め方</h2>
    <ol class="flow">
      {steps.map((s, i) => (
        <li>
          <span class="flow-num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="consult" class="section consult">
    <p class="sec-label">contact</p>
    <h2>開発の相談をする</h2>
    <p class="section-lead">
      まだ「こんなことできる？」くらいの段階で大丈夫です。質問に答えると相談メールの下書きができます。
      直接メールする場合は <a href={`mailto:${consult.email}`}>{consult.email}</a> へどうぞ。
    </p>
    <ConsultChat />
  </section>
</BaseLayout>

<style>
  .hero-band {
    background-color: var(--dark);
    background-image:
      linear-gradient(var(--dark-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--dark-line) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: -1px -1px;
    color: #e6edf6;
    border-bottom: 1px solid var(--dark-line);
  }
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 40px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 72px;
  }
  .eyebrow {
    margin: 0 0 14px;
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-bright);
  }
  .hero h1 {
    font-size: clamp(1.4rem, 5.6vw, 2.35rem);
    line-height: 1.4;
    margin: 0 0 18px;
    color: #fff;
  }
  .nw { display: inline-block; }
  .lead { color: #a9b6c8; font-size: 1.02rem; margin: 0 0 8px; max-width: 34em; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .btn--on-dark { color: #e6edf6; border-color: #4a5a75; }
  .btn--on-dark:hover { background: #e6edf6; color: var(--dark); }

  .terminal {
    background: var(--dark-2);
    border: 1px solid var(--dark-line);
    border-radius: 10px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    min-width: 0;
  }
  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--dark-line);
  }
  .terminal-bar span { width: 10px; height: 10px; border-radius: 50%; background: #3a4760; }
  .terminal-bar em { margin-left: 8px; font-style: normal; font-family: var(--mono); font-size: 0.75rem; color: #6f7f99; }
  .terminal pre {
    margin: 0;
    padding: 16px 18px 20px;
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.75;
    color: #c9d4e3;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .terminal .line { display: block; }
  .terminal .p { color: var(--accent-bright); }
  .terminal .o { color: #c9d4e3; }
  .terminal .c { color: #6f7f99; }
  .terminal .ok { color: var(--accent-bright); }
  .cursor { display: inline-block; width: 0.55em; height: 1.1em; vertical-align: text-bottom; background: var(--accent-bright); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }

  .section { padding: 80px 0 0; }
  .section h2 { margin: 4px 0 10px; font-size: clamp(1.4rem, 3vw, 1.85rem); }
  .section-lead { color: var(--ink-soft); margin: 0 0 32px; max-width: 46em; }

  .proofs {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .proofs li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 20px;
  }
  .proof-num { margin: 0; font-family: var(--mono); font-size: 2rem; font-weight: 600; line-height: 1.2; }
  .proof-num small { margin-left: 4px; font-family: 'Noto Sans JP', sans-serif; font-size: 0.9rem; font-weight: 500; color: var(--ink-soft); }
  .proofs h3 { margin: 6px 0 6px; font-size: 1rem; }
  .proofs li > p:last-child { margin: 0; font-size: 0.86rem; color: var(--ink-soft); line-height: 1.7; }

  .works { display: flex; flex-direction: column; gap: 28px; }

  .services { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .service {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
  }
  .service-icon { font-size: 1.4rem; }
  .service h3 { margin: 8px 0 6px; font-size: 1.02rem; }
  .service p { margin: 0 0 12px; font-size: 0.9rem; color: var(--ink-soft); flex-grow: 1; }
  .service a { font-size: 0.85rem; font-weight: 500; }

  .fits { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px; }
  .fit { border-radius: var(--radius); padding: 18px 22px; border: 1px solid var(--border); }
  .fit h3 { margin: 0 0 8px; font-size: 0.98rem; }
  .fit ul { margin: 0; padding-left: 1.2em; font-size: 0.9rem; }
  .fit--good { background: var(--good-bg); border-color: #c4e8d6; }
  .fit--bad { background: var(--surface-2); color: var(--ink-soft); }

  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .flow li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }
  .flow-num { font-family: var(--mono); font-weight: 600; font-size: 0.9rem; color: var(--accent); }
  .flow h3 { margin: 6px 0 4px; font-size: 1rem; }
  .flow p { margin: 0; font-size: 0.88rem; color: var(--ink-soft); }

  .consult .section-lead a { word-break: break-all; }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; padding-top: 48px; padding-bottom: 48px; }
    .proofs { grid-template-columns: 1fr 1fr; }
    .services { grid-template-columns: 1fr 1fr; }
    .flow { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .proofs, .services, .fits, .flow { grid-template-columns: 1fr; }
    .section { padding-top: 64px; }
  }
</style>
